# Services only; `src/Rules` belongs to the opt-in `rules.neon`.
attributeServicesDirectories:
  - src/Services

# Default parameters passed to phpstan by this extension.
parameters:
  dynamicConstantNames:
    - ABSPATH
    - COOKIEPATH
    - DB_NAME
    - DOMAIN_CURRENT_SITE
    - SITECOOKIEPATH
    - WPCOM_IS_VIP_ENV
    - WPINC
    - WP_PLUGIN_DIR
  scanFiles:
    - stubs/wp.php
