includes:
    - %rootDir%/../../../rules.neon

parameters:
    level: 10
    lipemat:
        noExtends: true
        allowedToBeExtended:
            - PHPStan\Testing\TypeInferenceTestCase
    paths:
        - src
    bootstrapFiles:
        - vendor/autoload.php
    scanFiles:
      - dev/phpunit/stubs/Container/Factory.php
    scanDirectories:
        - dev/stubs
    ignoreErrors:
        - # We don't want to use final classes as this is a distributed package.
            identifier: lipemat.classMustBeFinal
    excludePaths:
        - src/AddRootToExtensions.php
