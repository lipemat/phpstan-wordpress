# Including this file is what registers the rules carrying attributes in `src/Rules`.
attributeServicesDirectories:
  - src/Rules

## Supported custom parameters.
parametersSchema:
  lipemat: structure([
    allowedToBeExtended: listOf(string()),
    noExtends: bool(),
    nonDistributed: bool(),
    themePath: schema(string(), nullable()),
  ])

# Resolve a relative `themePath` against the config file which declares it, not the working directory.
expandRelativePaths:
  - '[parameters][lipemat][themePath]'

# Default parameters passed to phpstan by this extension.
parameters:
  lipemat:
    allowedToBeExtended: []
    noExtends: false
    nonDistributed: true
    themePath: null
